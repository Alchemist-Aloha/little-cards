{
  "name": "little-cards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-cards.mjs",
    "check:assets": "python3 tools/check_preamble.py",
